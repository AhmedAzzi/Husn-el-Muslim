[{"a":1,"t":"وَالضُّحٰىۙ","j":[]},{"a":2,"t":"وَالَّيْلِ اِذَا سَجٰىۙ","j":[]},{"a":3,"t":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰىۗ","j":[]},{"a":4,"t":"وَلَلْاٰخِرَةُ خَيْرٌ لَّكَ مِنَ الْاُوْلٰىۗ","j":[[19,24,"idgham-bilaghunnah"],[38,40,"madd-arid-lissukun"]]},{"a":5,"t":"وَلَسَوْفَ يُعْطِيْكَ رَبُّكَ فَتَرْضٰىۗ","j":[]},{"a":6,"t":"اَلَمْ يَجِدْكَ يَتِيْمًا فَاٰوٰىۖ","j":[[11,12,"qalqalah"],[22,24,"ikhfa"],[25,27,"ikhfa"],[28,30,"madd-arid-lissukun"]]},{"a":7,"t":"وَوَجَدَكَ ضَاۤلًّا فَهَدٰىۖ","j":[[15,18,"ikhfa"],[19,21,"ikhfa"]]},{"a":8,"t":"وَوَجَدَكَ عَاۤىِٕلًا فَاَغْنٰىۗ","j":[[13,16,"madd-wajib"],[18,20,"ikhfa"],[21,23,"ikhfa"]]},{"a":9,"t":"فَاَمَّا الْيَتِيْمَ فَلَا تَقْهَرْۗ","j":[[4,6,"ghunnah"],[29,30,"qalqalah"]]},{"a":10,"t":"وَاَمَّا السَّاۤىِٕلَ فَلَا تَنْهَرْ","j":[[4,6,"ghunnah"],[14,17,"madd-wajib"]]},{"a":11,"t":"وَاَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ ࣖ","j":[[4,6,"ghunnah"]]}]