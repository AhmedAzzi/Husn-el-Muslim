[{"a":1,"t":"اَرَءَيْتَ الَّذِيْ يُكَذِّبُ بِالدِّيْنِۗ","j":[[37,39,"madd-arid-lissukun"]]},{"a":2,"t":"فَذٰلِكَ الَّذِيْ يَدُعُّ الْيَتِيْمَۙ","j":[[33,35,"madd-arid-lissukun"]]},{"a":3,"t":"وَلَا يَحُضُّ عَلٰى طَعَامِ الْمِسْكِيْنِۗ","j":[[37,39,"madd-arid-lissukun"]]},{"a":4,"t":"فَوَيْلٌ لِّلْمُصَلِّيْنَۙ","j":[[6,11,"idgham-bilaghunnah"],[21,23,"madd-arid-lissukun"]]},{"a":5,"t":"الَّذِيْنَ هُمْ عَنْ صَلَاتِهِمْ سَاهُوْنَۙ","j":[[18,23,"ikhfa"],[38,40,"madd-arid-lissukun"]]},{"a":6,"t":"الَّذِيْنَ هُمْ يُرَاۤءُوْنَۙ","j":[[20,22,"madd-wajib"],[24,26,"madd-arid-lissukun"]]},{"a":7,"t":"وَيَمْنَعُوْنَ الْمَاعُوْنَ ࣖ","j":[[23,25,"madd-arid-lissukun"]]}]