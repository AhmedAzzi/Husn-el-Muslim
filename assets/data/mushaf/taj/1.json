[{"a":1,"t":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ","j":[[34,36,"madd-arid-lissukun"]]},{"a":2,"t":"اَلْحَمْدُ لِلّٰهِ رَبِّ الْعٰلَمِيْنَۙ","j":[[34,36,"madd-arid-lissukun"]]},{"a":3,"t":"الرَّحْمٰنِ الرَّحِيْمِۙ","j":[[19,21,"madd-arid-lissukun"]]},{"a":4,"t":"مٰلِكِ يَوْمِ الدِّيْنِۗ","j":[[19,21,"madd-arid-lissukun"]]},{"a":5,"t":"اِيَّاكَ نَعْبُدُ وَاِيَّاكَ نَسْتَعِيْنُۗ","j":[[37,39,"madd-arid-lissukun"]]},{"a":6,"t":"اِهْدِنَا الصِّرَاطَ الْمُسْتَقِيْمَ ۙ","j":[[32,34,"madd-arid-lissukun"]]},{"a":7,"t":"صِرَاطَ الَّذِيْنَ اَنْعَمْتَ عَلَيْهِمْ ەۙ غَيْرِ الْمَغْضُوْبِ عَلَيْهِمْ وَلَا الضَّاۤلِّيْنَ ࣖ","j":[[92,94,"madd-arid-lissukun"]]}]