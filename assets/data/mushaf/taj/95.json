[{"a":1,"t":"وَالتِّيْنِ وَالزَّيْتُوْنِۙ","j":[[23,25,"madd-arid-lissukun"]]},{"a":2,"t":"وَطُوْرِ سِيْنِيْنَۙ","j":[[15,17,"madd-arid-lissukun"]]},{"a":3,"t":"وَهٰذَا الْبَلَدِ الْاَمِيْنِۙ","j":[[25,27,"madd-arid-lissukun"]]},{"a":4,"t":"لَقَدْ خَلَقْنَا الْاِنْسَانَ فِيْٓ اَحْسَنِ تَقْوِيْمٍۖ","j":[[4,5,"qalqalah"],[11,12,"qalqalah"],[22,26,"ikhfa"],[32,36,"madd-jaiz"],[47,48,"qalqalah"],[51,53,"madd-arid-lissukun"]]},{"a":5,"t":"ثُمَّ رَدَدْنٰهُ اَسْفَلَ سَافِلِيْنَۙ","j":[[2,4,"ghunnah"],[10,11,"qalqalah"],[33,35,"madd-arid-lissukun"]]},{"a":6,"t":"اِلَّا الَّذِيْنَ اٰمَنُوْا وَعَمِلُوا الصّٰلِحٰتِ فَلَهُمْ اَجْرٌ غَيْرُ مَمْنُوْنٍۗ","j":[[62,63,"qalqalah"],[80,82,"madd-arid-lissukun"]]},{"a":7,"t":"فَمَا يُكَذِّبُكَ بَعْدُ بِالدِّيْنِۗ","j":[[32,34,"madd-arid-lissukun"]]},{"a":8,"t":"اَلَيْسَ اللّٰهُ بِاَحْكَمِ الْحٰكِمِيْنَ ࣖ","j":[[37,39,"madd-arid-lissukun"]]}]