[{"a":1,"t":"وَالشَّمْسِ وَضُحٰىهَاۖ","j":[]},{"a":2,"t":"وَالْقَمَرِ اِذَا تَلٰىهَاۖ","j":[]},{"a":3,"t":"وَالنَّهَارِ اِذَا جَلّٰىهَاۖ","j":[[4,6,"ghunnah"]]},{"a":4,"t":"وَالَّيْلِ اِذَا يَغْشٰىهَاۖ","j":[]},{"a":5,"t":"وَالسَّمَاۤءِ وَمَا بَنٰىهَاۖ","j":[[9,11,"madd-wajib"]]},{"a":6,"t":"وَالْاَرْضِ وَمَا طَحٰىهَاۖ","j":[]},{"a":7,"t":"وَنَفْسٍ وَّمَا سَوّٰىهَاۖ","j":[[6,11,"idgham-bighunnah"]]},{"a":8,"t":"فَاَلْهَمَهَا فُجُوْرَهَا وَتَقْوٰىهَاۖ","j":[[30,31,"qalqalah"]]},{"a":9,"t":"قَدْ اَفْلَحَ مَنْ زَكّٰىهَاۖ","j":[[2,3,"qalqalah"],[16,21,"ikhfa"]]},{"a":10,"t":"وَقَدْ خَابَ مَنْ دَسّٰىهَاۗ","j":[[4,5,"qalqalah"],[15,20,"ikhfa"]]},{"a":11,"t":"كَذَّبَتْ ثَمُوْدُ بِطَغْوٰىهَآ  ۖ","j":[]},{"a":12,"t":"اِذِ انْۢبَعَثَ اَشْقٰىهَاۖ","j":[[6,8,"iqlab"],[8,10,"iqlab"]]},{"a":13,"t":"فَقَالَ لَهُمْ رَسُوْلُ اللّٰهِ نَاقَةَ اللّٰهِ وَسُقْيٰهَاۗ","j":[[52,53,"qalqalah"]]},{"a":14,"t":"فَكَذَّبُوْهُ فَعَقَرُوْهَاۖ فَدَمْدَمَ عَلَيْهِمْ رَبُّهُمْ بِذَنْۢبِهِمْ فَسَوّٰىهَاۖ","j":[[58,63,"ikhfa-syafawi"],[65,67,"iqlab"],[67,69,"iqlab"]]},{"a":15,"t":"وَلَا يَخَافُ عُقْبٰهَا ࣖ","j":[[16,17,"qalqalah"]]}]