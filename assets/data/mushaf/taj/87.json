[{"a":1,"t":"سَبِّحِ اسْمَ رَبِّكَ الْاَعْلَىۙ ","j":[]},{"a":2,"t":"الَّذِيْ خَلَقَ فَسَوّٰىۖ ","j":[]},{"a":3,"t":"وَالَّذِيْ قَدَّرَ فَهَدٰىۖ ","j":[]},{"a":4,"t":"وَالَّذِيْٓ اَخْرَجَ الْمَرْعٰىۖ ","j":[[8,12,"madd-jaiz"]]},{"a":5,"t":"فَجَعَلَهٗ غُثَاۤءً اَحْوٰىۖ ","j":[[15,17,"madd-wajib"]]},{"a":6,"t":"سَنُقْرِئُكَ فَلَا تَنْسٰىٓ  ۖ ","j":[[4,5,"qalqalah"],[21,25,"ikhfa"]]},{"a":7,"t":"اِلَّا مَا شَاۤءَ اللّٰهُ ۗاِنَّهٗ يَعْلَمُ الْجَهْرَ وَمَا يَخْفٰىۗ ","j":[[13,15,"madd-wajib"],[29,31,"ghunnah"]]},{"a":8,"t":"وَنُيَسِّرُكَ لِلْيُسْرٰىۖ ","j":[]},{"a":9,"t":"فَذَكِّرْ اِنْ نَّفَعَتِ الذِّكْرٰىۗ ","j":[[12,17,"idgham-bighunnah"]]},{"a":10,"t":"سَيَذَّكَّرُ مَنْ يَّخْشٰىۙ ","j":[[15,20,"idgham-bighunnah"]]},{"a":11,"t":"وَيَتَجَنَّبُهَا الْاَشْقَىۙ ","j":[[8,10,"ghunnah"]]},{"a":12,"t":"الَّذِيْ يَصْلَى النَّارَ الْكُبْرٰىۚ ","j":[[19,21,"ghunnah"],[31,32,"qalqalah"]]},{"a":13,"t":"ثُمَّ لَا يَمُوْتُ فِيْهَا وَلَا يَحْيٰىۗ ","j":[[2,4,"ghunnah"]]},{"a":14,"t":"قَدْ اَفْلَحَ مَنْ تَزَكّٰىۙ ","j":[[2,3,"qalqalah"],[16,21,"ikhfa"]]},{"a":15,"t":"وَذَكَرَ اسْمَ رَبِّهٖ فَصَلّٰىۗ ","j":[]},{"a":16,"t":"بَلْ تُؤْثِرُوْنَ الْحَيٰوةَ الدُّنْيَاۖ ","j":[[34,38,"idgham-bighunnah"]]},{"a":17,"t":"وَالْاٰخِرَةُ خَيْرٌ وَّاَبْقٰىۗ ","j":[[18,23,"idgham-bighunnah"],[26,27,"qalqalah"]]},{"a":18,"t":"اِنَّ هٰذَا لَفِى الصُّحُفِ الْاُوْلٰىۙ ","j":[[2,4,"ghunnah"],[33,35,"madd-arid-lissukun"]]},{"a":19,"t":"صُحُفِ اِبْرٰهِيْمَ وَمُوْسٰى ࣖ ","j":[[9,10,"qalqalah"],[24,26,"madd-arid-lissukun"]]}]