<?xml version="1.0" encoding="utf-8"?>
<!-- Interactive todo widget: tap the circle to mark done (4x3).
      Updates are pushed manually (toggle tap / Dart change / boot),
      so the period is 0. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/todo_widget"
    android:previewLayout="@layout/todo_widget"
    android:description="@string/todo_widget_desc"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen">
</appwidget-provider>
