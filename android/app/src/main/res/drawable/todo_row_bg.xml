<?xml version="1.0" encoding="utf-8"?>
<!-- Todo row card: deep burgundy gradient + gold hairline, following the
     app's dark Islamic identity. A shade lighter than the night root so it
     layers on it, and a bold contrast card on the ivory day root.
     Row content is always light-on-dark. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#6E3B46"
        android:endColor="#4E2A30"
        android:angle="135" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="#59C9A227" />
</shape>
