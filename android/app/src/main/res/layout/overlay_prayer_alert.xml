<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/prayer_alert_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/overlay_prayer_backdrop"
    android:layoutDirection="rtl">

    <!-- ========================================================= -->
    <!-- TOP GOLD ACCENT                                           -->
    <!-- ========================================================= -->

    <View
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_gravity="top"
        android:background="@drawable/overlay_gold_divider" />

    <!-- ========================================================= -->
    <!-- DECORATIVE STARS                                          -->
    <!-- ========================================================= -->

    <View
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="34dp"
        android:layout_marginTop="100dp"
        android:alpha="0.55"
        android:background="@drawable/overlay_star_white" />

    <View
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="52dp"
        android:layout_marginTop="165dp"
        android:alpha="0.45"
        android:background="@drawable/overlay_circle_gold" />

    <View
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="28dp"
        android:layout_marginTop="340dp"
        android:alpha="0.50"
        android:background="@drawable/overlay_star_white" />

    <View
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="65dp"
        android:layout_marginTop="420dp"
        android:alpha="0.45"
        android:background="@drawable/overlay_star_white" />

    <View
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="60dp"
        android:layout_marginBottom="180dp"
        android:alpha="0.40"
        android:background="@drawable/overlay_star_white" />

    <View
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="140dp"
        android:alpha="0.45"
        android:background="@drawable/overlay_circle_gold" />



    <!-- ========================================================= -->
    <!-- MAIN CONTENT                                              -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/prayer_alert_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layoutDirection="rtl"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp">

        <!-- ===================================================== -->
        <!-- BASMALA                                               -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/prayer_alert_basmala"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/amiri_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="بسم الله الرحمن الرحيم"
            android:textColor="@color/overlay_gold_light"
            android:textSize="22sp" />

        <!-- ===================================================== -->
        <!-- MAIN CARD                                             -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="16dp"
            android:elevation="10dp"
            android:gravity="center"
            android:orientation="vertical"
            android:layoutDirection="rtl"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="30dp"
            android:paddingBottom="30dp">

            <!-- ================================================= -->
            <!-- BADGE                                             -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/prayer_alert_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/overlay_prayer_badge"
                android:fontFamily="@font/amiri_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="الله أكبر، الله أكبر"
                android:textColor="@color/overlay_gold_light"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- ================================================= -->
            <!-- PRAYER TITLE                                      -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/prayer_alert_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/amiri_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/overlay_ivory"
                android:textSize="42sp"
                android:textStyle="bold"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="10"
                tools:text="صلاة الفجر" />

            <!-- ================================================= -->
            <!-- ADHAN                                             -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/amiri_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="حي على الصلاة، حي على الفلاح"
                android:textColor="@color/overlay_sand"
                android:textSize="19sp" />

            <!-- ================================================= -->
            <!-- DIVIDER                                            -->
            <!-- ================================================= -->

            <View
                android:layout_width="82dp"
                android:layout_height="2dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/overlay_gold_divider" />

            <!-- ================================================= -->
            <!-- QURAN VERSE                                       -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/prayer_alert_verse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/amiri_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:layoutDirection="rtl"
                android:text="إِنَّ الصَّلَاةَ كَانَتْ عَلَى الْمُؤْمِنِينَ&#10;كِتَابًا مَوْقُوتًا"
                android:textAlignment="center"
                android:textColor="@color/overlay_ivory"
                android:textDirection="rtl"
                android:textSize="27sp"
                android:lineSpacingExtra="4dp"
                android:lineSpacingMultiplier="1.15" />

            <!-- ================================================= -->
            <!-- VERSE SOURCE                                      -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/prayer_alert_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/amiri_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="﴿ سورة النساء: ١٠٣ ﴾"
                android:textColor="@color/overlay_gold_light"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- DUA                                                   -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/prayer_alert_dua"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/amiri_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:layoutDirection="rtl"
            android:lineSpacingMultiplier="1.3"
            android:text="رَبِّ اجْعَلْنِي مُقِيمَ الصَّلَاةِ وَمِنْ ذُرِّيَّتِي رَبَّنَا وَتَقَبَّلْ دُعَاءِ"
            android:textAlignment="center"
            android:textColor="@color/overlay_sand"
            android:textDirection="rtl"
            android:textSize="17sp" />

        <!-- ===================================================== -->
        <!-- DUA SOURCE                                            -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/amiri_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="﴿ سورة إبراهيم: ٤٠ ﴾"
            android:textColor="@color/overlay_muted"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ========================================================= -->
    <!-- CLOSE BUTTON                                              -->
    <!-- ========================================================= -->

    <TextView
        android:id="@+id/prayer_alert_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/overlay_prayer_close_gold"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"
        android:fontFamily="@font/amiri_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minHeight="56dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="إغلاق"
        android:textColor="@color/overlay_sand"
        android:textSize="21sp"
        android:textStyle="bold" />

</FrameLayout>
