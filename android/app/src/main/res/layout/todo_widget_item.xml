<?xml version="1.0" encoding="utf-8"?>
<!-- One widget row: gold ring checkbox (toggles done) + bold white title
     over a subtle divider + gold due label. Same IDs as before so the
     Kotlin binding is untouched. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/todo_row_bg"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <FrameLayout
        android:layout_width="28dp"
        android:layout_height="28dp">

        <ImageView
            android:id="@+id/todo_item_check"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/todo_check_off" />

        <TextView
            android:id="@+id/todo_item_mark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="✓"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/todo_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مهمة"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/todo_item_due"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFD700" />
    </LinearLayout>
</LinearLayout>
